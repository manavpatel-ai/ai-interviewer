    {
      "parameters": {
        "jsCode": "// Prepare data for Google Sheets\nconst data = $input.first().json.body;\n\n// Format Q&A pairs as text\nconst qaText = data.questions_answers.map((qa, i) => \n  `Q${i+1}: ${qa.question}\\nA${i+1}: ${qa.answer}\\n`\n).join('\\n');\n\n// Format scores\nconst scoresText = data.scores.map((s, i) => \n  `Q${i+1}: ${s.score}/10 (${s.sentiment})`\n).join(', ');\n\nreturn {\n  json: {\n    candidate_name: data.candidate_name,\n    candidate_email: data.candidate_email,\n    position: data.position,\n    interview_date: new Date(data.interview_date).toLocaleString(),\n    average_score: data.average_score,\n    overall_assessment: data.overall_assessment,\n    status: data.status,\n    next_step: data.next_step,\n    qa_transcript: qaText,\n    scores_summary: scoresText,\n    full_data: JSON.stringify(data, null, 2)\n  }\n};"
      },
